.content {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.para {
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.8;
  color: #6C757D;
}

.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.btn {
  flex: 1;
  text-align: center;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  margin: 0 12rpx;
}

.btn.secondary {
  border: 2rpx solid #E9ECEF;
}

.btn.primary {
  background: #E85D4C;
  color: #fff;
}
