.select-all {
  padding: 24rpx;
  background: #fff;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  margin-top: 2rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 16rpx;
}

.info {
  flex: 1;
}

.name {
  display: block;
  font-size: 28rpx;
}

.spec {
  font-size: 24rpx;
  color: #ADB5BD;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.qty text {
  display: inline-block;
  width: 48rpx;
  text-align: center;
}

.invalid {
  color: #ADB5BD;
}

.delete {
  color: #D63031;
  font-size: 24rpx;
  padding: 16rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.checkout-btn {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
