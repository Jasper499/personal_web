.cart-page {
  padding-bottom: 160rpx;
}

.select-all {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
}

.check-wrap {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ADB5BD;
  border-radius: 50%;
  margin-right: 16rpx;
  position: relative;
}

.checkbox.checked {
  background: #E85D4C;
  border-color: #E85D4C;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 10rpx;
  height: 18rpx;
  border: 2rpx solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

.checkbox.disabled {
  opacity: 0.4;
}

.cart-item {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 28rpx;
  color: #2D3436;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec {
  font-size: 24rpx;
  color: #ADB5BD;
  margin-top: 8rpx;
  display: block;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.qty {
  display: flex;
  align-items: center;
  border: 1rpx solid #E9ECEF;
  border-radius: 8rpx;
}

.qty-btn {
  width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6C757D;
  line-height: 48rpx;
}

.qty-num {
  width: 56rpx;
  text-align: center;
  border-left: 1rpx solid #E9ECEF;
  border-right: 1rpx solid #E9ECEF;
  line-height: 48rpx;
  font-size: 26rpx;
}

.invalid {
  color: #ADB5BD;
  font-size: 24rpx;
}

.delete {
  color: #D63031;
  font-size: 24rpx;
  padding: 16rpx 0 16rpx 16rpx;
  flex-shrink: 0;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.footer-total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #6C757D;
  margin-right: 8rpx;
}

.checkout-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #2D3436;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #ADB5BD;
  display: block;
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-block;
  padding: 0 64rpx;
  height: 80rpx;
  line-height: 80rpx;
}
