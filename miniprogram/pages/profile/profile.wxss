.header {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
  background: #E9ECEF;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.phone {
  font-size: 24rpx;
  color: #ADB5BD;
}

.section-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.more {
  color: #ADB5BD;
  font-size: 24rpx;
}

.shortcuts {
  display: flex;
  justify-content: space-around;
}

.shortcut {
  text-align: center;
  font-size: 24rpx;
}

.icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 8rpx;
}

.menu-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #E9ECEF;
}

.menu-item:last-child {
  border-bottom: none;
}
