.profile-page {
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 64rpx;
  background: linear-gradient(135deg, #E85D4C 0%, #F4A261 100%);
  margin-bottom: -32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  display: block;
}

.welcome {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
  display: block;
}

.phone {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
  display: block;
}

.order-card {
  margin: 0 24rpx 24rpx;
  position: relative;
  z-index: 1;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.more {
  color: #ADB5BD;
  font-size: 24rpx;
}

.shortcuts {
  display: flex;
  justify-content: space-around;
}

.shortcut {
  text-align: center;
}

.shortcut-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 40rpx;
  background: #FFF5F4;
  border-radius: 24rpx;
  margin: 0 auto 12rpx;
}

.shortcut-label {
  font-size: 24rpx;
  color: #6C757D;
}

.menu {
  margin: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #E9ECEF;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #2D3436;
}

.menu-arrow {
  color: #ADB5BD;
  font-size: 32rpx;
}
