.gallery {
  height: 750rpx;
}

.gallery-img {
  width: 100%;
  height: 750rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 0;
}

.meta {
  color: #ADB5BD;
  font-size: 24rpx;
}

.sku-selected {
  float: right;
  color: #6C757D;
}

.detail {
  margin-bottom: 120rpx;
}

.section-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bar-btn {
  flex: 1;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #E85D4C;
  color: #E85D4C;
  border-radius: 40rpx;
  margin: 0 8rpx;
}

.bar-btn.primary {
  background: #E85D4C;
  color: #fff;
  border: none;
}

.sku-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.sku-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.sku-tag {
  display: inline-block;
  padding: 12rpx 24rpx;
  border: 2rpx solid #E9ECEF;
  border-radius: 8rpx;
  margin: 8rpx;
}

.sku-tag.active {
  border-color: #E85D4C;
  color: #E85D4C;
}

.qty-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 0;
}

.qty-ctrl text {
  display: inline-block;
  width: 56rpx;
  text-align: center;
  font-size: 32rpx;
}
