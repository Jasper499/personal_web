<view class="import-bar">
  <view class="import-btn" bindtap="onImportWechat">📍 从微信地址导入</view>
</view>

<view class="card form">
  <view class="field">
    <text class="label">收货人</text>
    <input data-field="name" value="{{form.name}}" placeholder="姓名" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="label">手机号</text>
    <input data-field="phone" type="number" maxlength="11" value="{{form.phone}}" placeholder="11位手机号" bindinput="onInput" />
  </view>
  <view class="field">
    <text class="label">所在地区</text>
    <picker mode="region" bindchange="onRegionChange" value="{{region}}">
      <view class="picker-value {{form.province ? '' : 'placeholder'}}">
        {{form.province ? form.province + ' ' + form.city + ' ' + form.district : '请选择省市区'}}
      </view>
    </picker>
  </view>
  <view class="field">
    <text class="label">详细地址</text>
    <input data-field="detail" value="{{form.detail}}" placeholder="街道、门牌号等" bindinput="onInput" />
  </view>
  <label class="field default-row">
    <checkbox checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#E85D4C" />
    <text>设为默认地址</text>
  </label>
</view>
<view class="btn-primary save-btn" bindtap="onSave">保存</view>
