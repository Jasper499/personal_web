<view class="card form">
  <view class="field">
    <text>收货人</text>
    <input data-field="name" value="{{form.name}}" bindinput="onInput" />
  </view>
  <view class="field">
    <text>手机号</text>
    <input data-field="phone" type="number" value="{{form.phone}}" bindinput="onInput" />
  </view>
  <view class="field">
    <text>省份</text>
    <input data-field="province" value="{{form.province}}" bindinput="onInput" placeholder="如：北京市" />
  </view>
  <view class="field">
    <text>城市</text>
    <input data-field="city" value="{{form.city}}" bindinput="onInput" />
  </view>
  <view class="field">
    <text>区县</text>
    <input data-field="district" value="{{form.district}}" bindinput="onInput" />
  </view>
  <view class="field">
    <text>详细地址</text>
    <input data-field="detail" value="{{form.detail}}" bindinput="onInput" />
  </view>
  <label class="field">
    <checkbox checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#E85D4C" /> 设为默认地址
  </label>
</view>
<view class="btn-primary save-btn" bindtap="onSave">保存</view>
