.import-bar {
  padding: 24rpx 24rpx 0;
}

.import-btn {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  color: #E85D4C;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form {
  margin: 24rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E9ECEF;
}

.field:last-child {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6C757D;
  margin-bottom: 12rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #212529;
}

.picker-value.placeholder {
  color: #ADB5BD;
}

.default-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}

.save-btn {
  margin: 32rpx 24rpx;
}
