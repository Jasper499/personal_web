.page {
  display: flex;
  height: 100vh;
}

.sidebar {
  width: 180rpx;
  background: #F8F9FA;
  height: 100%;
}

.cat-item {
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6C757D;
}

.cat-item.active {
  background: #fff;
  color: #E85D4C;
  font-weight: 600;
  border-left: 6rpx solid #E85D4C;
}

.main {
  flex: 1;
  background: #fff;
  padding: 16rpx;
}

.product-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E9ECEF;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.name {
  font-size: 28rpx;
}

.sales {
  font-size: 22rpx;
  color: #ADB5BD;
  margin-left: 8rpx;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #6C757D;
  font-size: 28rpx;
}

.empty-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #ADB5BD;
}
