<view class="page" wx:if="{{order}}">
  <view class="pay-banner" wx:if="{{order.status === 'pending'}}">
    <text class="pay-banner-title">订单待付款</text>
    <text class="pay-banner-tip" wx:if="{{mockPay}}">开发环境请点击下方按钮完成模拟支付</text>
    <text class="pay-banner-tip" wx:else>请使用微信支付完成付款</text>
    <view class="pay-banner-btn" bindtap="onPay">立即{{payLabel}} ￥{{order.payAmount}}</view>
  </view>

  <view class="card status-card">
    <text class="status">{{statusMap[order.status]}}</text>
    <text wx:if="{{order.pickupCode}}" class="pickup-code">取货码：{{order.pickupCode}}</text>
    <text wx:if="{{order.status === 'shipped' && order.expressNo}}" class="express-info">
      {{order.expressCompany}} {{order.expressNo}}
    </text>
  </view>

  <view class="card" wx:if="{{order.deliveryType === 'express' && order.addressSnapshot}}">
    <text>{{order.addressSnapshot.name}} {{order.addressSnapshot.phone}}</text>
    <text class="addr">{{order.addressSnapshot.province}}{{order.addressSnapshot.city}}{{order.addressSnapshot.district}}{{order.addressSnapshot.detail}}</text>
  </view>

  <view class="card" wx:if="{{order.deliveryType === 'pickup'}}">
    <text>到店自提 · 匠心小铺默认门店</text>
  </view>

  <view class="card">
    <view class="item" wx:for="{{order.items}}" wx:key="id">
      <image class="thumb" src="{{item.coverImage}}" mode="aspectFill" />
      <view class="info">
        <text>{{item.productName}}</text>
        <text class="spec" wx:if="{{item.specName}}">{{item.specName}}</text>
        <view class="row">
          <text class="price">￥{{item.price}}</text>
          <text>x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row"><text>商品金额</text><text>￥{{order.totalAmount}}</text></view>
    <view class="row"><text>运费</text><text>￥{{order.freight}}</text></view>
    <view class="row total"><text>实付金额</text><text class="price">￥{{order.payAmount}}</text></view>
    <view class="row"><text>订单编号</text><text>{{order.orderNo}}</text></view>
  </view>

  <view class="footer" wx:if="{{order.status === 'pending' || order.status === 'shipped'}}">
    <view class="btn-secondary" wx:if="{{order.status === 'pending'}}" bindtap="onCancel">取消订单</view>
    <view class="btn-primary" wx:if="{{order.status === 'pending'}}" bindtap="onPay">{{payLabel}}</view>
    <view class="btn-primary full" wx:if="{{order.status === 'shipped'}}" bindtap="onConfirmReceive">确认收货</view>
  </view>
</view>

<view class="loading" wx:else>
  <text>{{loading ? '加载订单中...' : '订单不存在或加载失败'}}</text>
  <view class="btn-primary retry-btn" wx:if="{{!loading}}" bindtap="loadOrder">重试</view>
</view>
