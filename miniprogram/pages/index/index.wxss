.store-header {
  padding: 32rpx 24rpx 8rpx;
  background: linear-gradient(180deg, #fff 0%, #F8F9FA 100%);
}

.store-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #2D3436;
  display: block;
}

.store-slogan {
  font-size: 24rpx;
  color: #6C757D;
  margin-top: 8rpx;
  display: block;
}

.search-bar {
  margin: 16rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 44rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #ADB5BD;
  font-size: 28rpx;
}

.banner {
  height: 320rpx;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.banner-img {
  width: 100%;
  height: 320rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 8rpx;
  margin: 24rpx;
}

.category-item {
  width: 25%;
  text-align: center;
  padding: 16rpx 0;
}

.category-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 8rpx;
  background: #FFF5F4;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon {
  font-size: 44rpx;
}

.category-name {
  font-size: 24rpx;
  color: #6C757D;
}

.section {
  padding: 0 24rpx 32rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
  margin-right: 16rpx;
}

.section-sub {
  font-size: 24rpx;
  color: #ADB5BD;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.product-img-wrap {
  position: relative;
}

.product-img {
  width: 100%;
  height: 340rpx;
  display: block;
}

.promo-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #F9CA24;
  color: #2D3436;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
  height: 72rpx;
  color: #212529;
}

.price-row {
  margin-top: 8rpx;
}

.sales {
  font-size: 22rpx;
  color: #ADB5BD;
  margin-top: 4rpx;
  display: block;
}

.skeleton-banner {
  height: 320rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #E9ECEF 25%, #F8F9FA 50%, #E9ECEF 75%);
  background-size: 200% 100%;
  animation: shimmer 1.2s infinite;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

.skeleton-card {
  width: 48%;
  height: 420rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(90deg, #E9ECEF 25%, #F8F9FA 50%, #E9ECEF 75%);
  background-size: 200% 100%;
  animation: shimmer 1.2s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.state-panel {
  margin: 48rpx 24rpx;
  padding: 48rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
}

.state-panel.error {
  border: 1rpx solid #F8D7DA;
  background: #FFF5F5;
}

.state-text {
  display: block;
  font-size: 28rpx;
  color: #6C757D;
  line-height: 1.6;
}

.retry-btn {
  margin-top: 24rpx;
  background: #E85D4C;
  color: #fff;
}
