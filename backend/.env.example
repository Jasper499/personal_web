DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=3000

# 微信小程序（生产环境填写真实值）
WX_APPID=""
WX_SECRET=""
MOCK_WX_LOGIN=true

# 微信支付（生产环境填写，MOCK_PAY=false 启用真实支付）
MOCK_PAY=true
WX_MCH_ID=""
WX_PAY_KEY=""
WX_PAY_NOTIFY_URL=""

# 订阅消息模板 ID（在微信公众平台配置后填写）
WX_TMPL_ORDER_PAID=""
WX_TMPL_ORDER_SHIPPED=""
WX_TMPL_ORDER_PICKUP=""

# 管理后台默认账号（首次 seed 创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
